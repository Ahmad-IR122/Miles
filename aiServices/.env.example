ENV=development

# Azure OpenAI chat resource
AZURE_OPENAI_ENDPOINT=https://YOUR_OPENAI_RESOURCE.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=YOUR_CHAT_DEPLOYMENT
AZURE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AZURE_OPENAI_API_VERSION=2025-03-01-preview

# Azure OpenAI embedding resource for vector search
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://EMBEDDING_ENDPOINT.openai.azure.com/
AZURE_OPENAI_EMBEDDING_API_KEY=PASTE_ASAL_QFA_OPENAI_KEY_HERE
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://YOUR_SEARCH_SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=YOUR_SEARCH_KEY
AZURE_SEARCH_INDEX_NAME=project-a-index

# To import dataset from Azure Blob Storage, you need to set AZURE_STORAGE_CONTAINER
# plus one of the two auth options below.
AZURE_STORAGE_CONTAINER=team-a

# Option A (recommended for local dev — no `az login` needed):
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net

# Option B (falls back to this if the connection string above isn't set —
# requires the Azure CLI installed and `az login` run first):
AZURE_STORAGE_ACCOUNT_URL=https://YOUR_STORAGE_ACCOUNT.blob.core.windows.net