ENV=development

# Required - the app fails to start without it.
DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres"
# URL of the aiServices FastAPI app. The trip and itinerary endpoints call it.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT=120.0

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Required - Clerk signing secret for the user.created webhook.
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
